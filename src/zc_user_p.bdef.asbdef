projection;
strict ( 2 );

define behavior for ZC_USER_P alias User
use etag
{
  use create;
  use update;
  use delete;

  use action DownloadExcel;
  use action uploadExcelData;

  use association _UserDev { create; }
}

define behavior for ZC_USER_C alias UserDev
use etag
{
  use update;
  use delete;

  use association _User;
}